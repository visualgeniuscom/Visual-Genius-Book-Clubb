# Supabase Client (Frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Admin (Backend / Netlify functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for adding/editing books (defaults to 'admin' if empty)
ADMIN_PASSWORD=admin

# Optional: Resend API credentials for sending password reset emails
RESEND_API_KEY=
RESEND_FROM=Book Club <onboarding@resend.dev>

# Port (AI Studio runs on 3000)
PORT=3000
